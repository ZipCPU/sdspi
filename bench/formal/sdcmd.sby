[tasks]
prf
prfds prf opt_ds
cvr

[options]
prf: mode prove
cvr: mode cover
prf: depth 8
cvr: depth 200

[engines]
smtbmc

[script]
read -formal sdcmd.v
--pycode-begin--
cmd = "hierarchy -top sdcmd"
cmd += " -chparam OPT_EMMC 1"
cmd += " -chparam OPT_DS %d"  % ( 1 if "opt_ds" in tags else 0)
cmd += " -chparam STARTUP_CLOCKS %d"  % ( 12 if "cvr" in tags else 80)
cmd += " -chparam POWERUP_COUNT  %d"  % (  7 if "cvr" in tags else 100000)
cmd += " -chparam LGTIMEOUT      %d"  % (  4 if "cvr" in tags else 26)
output(cmd)
--pycode-end--
proc -norom
prep -top sdcmd

[files]
../../rtl/sdio/sdcmd.v
